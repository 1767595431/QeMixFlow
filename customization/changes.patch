+      request.generateAudio ? " --audio true" : "",
+      request.watermark === undefined ? "" : ` --watermark ${request.watermark}`,
+    ].join("");
+    const content: Record<string, unknown>[] = [{ type: "text", text: `${request.prompt}${flags}` }];
